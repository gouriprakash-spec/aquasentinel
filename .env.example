# Copy this file to .env and fill in real values.
# Never commit the real .env file — it must stay in .gitignore.

# AquaSentinel's own base URL - used by the RPHSA stub (app/rphsa_stub.py) to know where
# to register its FHIR Subscription at startup. Not a secret; safe to commit as a default.
AQUASENTINEL_BASE_URL=http://localhost:8000

# RPHSA stub's own base URL - tells AquaSentinel where to deliver FHIR notifications.
# Not a secret; safe to commit as a default. The RPHSA stub is not deployed on Render
# (see docs/deploy-render.md), so localhost defaults are fine.
RPHSA_BASE_URL=http://localhost:8001

# Public hostname(s) the MCP server should accept, comma-separated, bare hostnames only (no
# https:// and no path). Required on a real deploy: without it every MCP request is rejected
# with "Invalid Host header". Not a secret - it is your public URL. Leave unset for local dev.
# Example on Render: AQUASENTINEL_ALLOWED_HOSTS=aquasentinel.onrender.com
AQUASENTINEL_ALLOWED_HOSTS=

# Full path of the SQLite database file. Set it on a deploy that has a persistent disk, so readings,
# alert state and FHIR records survive restarts and redeploys. Not a secret. Leave unset for local
# dev (the file then lives in the repo root, as before).
# Example on Render, with a disk mounted at /var/data: AQUASENTINEL_DB_PATH=/var/data/aquasentinel.db
AQUASENTINEL_DB_PATH=
